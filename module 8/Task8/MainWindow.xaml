<Window x:Class="Task8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid x:Name="Grid1">
        <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="220" Margin="67,10,0,0" VerticalAlignment="Top" Width="256" Background="#FFC9C9C9">
            <Line Stroke="AliceBlue" StrokeThickness="3" X1="3" X2="3" Y2="150" Canvas.Left="207" Canvas.Top="35"/>
            <Line Stroke="AliceBlue" StrokeThickness="3" X1="3" X2="-75" Canvas.Left="207" Canvas.Top="35"/>
            <Line Stroke="AliceBlue" StrokeThickness="3" X1="3" X2="3" Y2="25" Canvas.Left="128" Canvas.Top="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Line Stroke="AliceBlue" StrokeThickness="3" X1="3" X2="-75" Canvas.Left="243" Canvas.Top="184" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Ellipse x:Name="First" Stroke="AliceBlue" StrokeThickness="3" Width="50" Height="50" Canvas.Left="103" Canvas.Top="60" Visibility="Hidden"/>
            <Line x:Name="Second" Stroke="AliceBlue" StrokeThickness="3" X1="130" Y1="110" X2="130" Y2="130" Visibility="Hidden"/>
            <Line x:Name="Third" Stroke="AliceBlue" StrokeThickness="3" X1="130" Y1="110" X2="150" Y2="130" Visibility="Hidden"/>
            <Line x:Name="Fourth" Stroke="AliceBlue" StrokeThickness="3" X1="130" Y1="110" X2="110" Y2="130" Visibility="Hidden"/>
            <Line x:Name="Fifth" Stroke="AliceBlue" StrokeThickness="3" X1="130" Y1="130" X2="150" Y2="150" Visibility="Hidden"/>
            <Line x:Name="Sixth" Stroke="AliceBlue" StrokeThickness="3" X1="130" Y1="130" X2="110" Y2="150" Visibility="Hidden"/>
        </Canvas>
        <Label Content="Загаданное слово:" HorizontalAlignment="Left" Margin="515,26,0,0" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label_word" HorizontalAlignment="Left" Margin="496,107,0,0" VerticalAlignment="Top" FontSize="24" FontFamily="Cascadia Mono" Width="239" Height="45"/>
        <Button x:Name="Button_make_new_word" Content="Загадать новое слово" HorizontalAlignment="Left" Margin="468,181,0,0" VerticalAlignment="Top" Width="167" Click="Button_make_new_word_Click"/>
    </Grid>
</Window>
