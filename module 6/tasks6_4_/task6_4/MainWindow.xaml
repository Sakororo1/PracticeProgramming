<Window x:Class="task6_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"  
    Title="Финансы" Height="500" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
        <x:Array x:Key="TypeItems" Type="{x:Type sys:String}">
            <sys:String>Расход</sys:String>
            <sys:String>Доход</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBox Width="200" Margin="0,0,5,0"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="100" Margin="0,0,5,0"
                     Text="{Binding NewSum, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Доход" VerticalAlignment="Center" Margin="0,0,5,0"
                      IsChecked="{Binding NewType}"/>
            <Button Content="Добавить" Click="Add_Click"/>
        </StackPanel>
        <DataGrid x:Name="dataGrid" Grid.Row="1" Margin="0,10"
                  ItemsSource="{Binding Finances}"   
            SelectedItem="{Binding SelectedFinance}"
            AutoGenerateColumns="False"
            CanUserAddRows="False" CellEditEnding="dataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"       Binding="{Binding fid}"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding fname}"/>
                <DataGridTextColumn Header="Сумма"    Binding="{Binding fsum}"/>
                <DataGridTemplateColumn Header="Тип">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding ftypeDisplay, Mode=OneWay}"
                      ItemsSource="{Binding Source={StaticResource TypeItems}}"
                      SelectionChanged="TypeCombo_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Content="Удалить" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}"/>
    </Grid>
</Window>