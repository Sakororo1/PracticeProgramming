<Window x:Class="task6_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Финансы" Height="500" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
        <x:Array x:Key="TypeItems" Type="{x:Type sys:String}">
            <sys:String>Расход</sys:String>
            <sys:String>Доход</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid>
        <Label Content="Название:" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="100,22,450,0" VerticalAlignment="Top" Height="25"/>
        <Label Content="Сумма:" Margin="355,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Width="100" Text="{Binding NewSum, UpdateSourceTrigger=PropertyChanged}" Margin="410,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="25"/>
        <CheckBox Content="Доход" Margin="540,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding NewType}"/>
        <Button Content="Добавить" Click="Add_Click" Margin="630,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25"/>
        <Button Content="Удалить" Click="Delete_Click" Margin="20,450,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25"/>
        <DataGrid x:Name="dataGrid" Margin="20,60,20,41"
                  ItemsSource="{Binding Finances}"
                  SelectedItem="{Binding SelectedFinance}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CellEditEnding="dataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"       Binding="{Binding fid}"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Название" Binding="{Binding fname}"/>
                <DataGridTextColumn Header="Сумма"    Binding="{Binding fsum}"/>
                <DataGridTemplateColumn Header="Тип">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding ftypeDisplay, Mode=OneWay}"
                                      ItemsSource="{Binding Source={StaticResource TypeItems}}"
                                      SelectionChanged="TypeCombo_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding ErrorMessage}" Margin="20,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</Window>