<Window x:Class="task6_2_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:task6_2_"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="MainWindow_Load">
    <Grid>
        <ListBox x:Name="checkedListBox1"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="15,12,0,0" Width="766" Height="259"
                 SelectionChanged="checkedListBox1_SelectedIndexChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding name}" IsChecked="{Binding state}" Click="TaskCheckBox_Click"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label x:Name="label1" Content="Название:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,273,0,0"/>
        <TextBox x:Name="textBox_name" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,301,0,0" Width="287" Height="22"/>
        <Label x:Name="label2" Content="Описание:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,330,0,0"/>
        <TextBox x:Name="textBox_description" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,361,0,0" Width="287" Height="22"/>
        <Button x:Name="button_Add" Content="Добавить задачу" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,388,0,0" Width="126" Height="25" Click="button_Add_Click"/>
        <Button x:Name="button1" Content="Удалить выбранное" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="333,283,0,0" Width="127" Height="58" Click="button1_Click"/>
        <Label x:Name="label3" Content="Название:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="505,283,0,0"/>
        <Label x:Name="label4" Content="Описание:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="505,309,0,0" RenderTransformOrigin="0.615,-1.006"/>
    </Grid>
</Window>